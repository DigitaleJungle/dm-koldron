{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DM's Koldron",
  "mainBinaryName": "koldron",
  "version": "0.0.4",
  "identifier": "be.digitalejungle.koldron",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "DM's Koldron",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
