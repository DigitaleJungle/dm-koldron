{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DM's Koldron",
  "mainBinaryName": "koldron",
  "version": "0.8.0",
  "identifier": "be.digitalejungle.koldron",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "DM's Koldron",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "koldron-addon: http://koldron-addon.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/campaigns/*/picture.jpg",
          "$APPDATA/archived-campaigns/*/picture.jpg",
          "$APPDATA/campaigns/*/characters/*.jpg",
          "$APPDATA/campaigns/*/encounters/*.jpg",
          "$APPDATA/campaigns/*/sessions/*.jpg",
          "$APPDATA/campaigns/*/locations/*/*.jpg",
          "$APPDATA/campaigns/*/npcs/*/*.jpg",
          "$APPDATA/images/*/*.png",
          "$APPDATA/images/*/*.jpg",
          "$APPDATA/images/*/*.jpeg",
          "$APPDATA/images/*/*.webp"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../packs/srd/LICENSE.md": "packs/srd/LICENSE.md",
      "../packs/srd/pack.json": "packs/srd/pack.json",
      "../packs/srd/encounter-budgets.json": "packs/srd/encounter-budgets.json",
      "../packs/srd/images.json": "packs/srd/images.json",
      "../packs/srd/source/2024/en/": "packs/srd/source/2024/en/",
      "../packs/tabler-icons/LICENSE": "packs/tabler-icons/LICENSE"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4QjNEM0E2ODcyNzczMkYKUldRdmN5ZUhwdE96bU5CVjNPYXl4TUltT2VjYTBmMXgxSlptMkZWTmsyY1Y0MklxTHUxN2p6aHMK",
      "endpoints": [
        "https://github.com/DigitaleJungle/dm-koldron/releases/latest/download/latest.json"
      ]
    }
  }
}
